# Unity generated folders (both root and Cave Souls subfolder)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta
!/Cave Souls/[Aa]ssets/**/*.meta

# Autogenerated VS/Rider/MonoDevelop solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vs/
.idea/
.vscode/

# Unity3D generated file on crash reports
sysinfo.txt

# Builds and packages
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Blender backup files (keep .blend master files!)
*.blend1
*.blend2

# Screenshots
[Ss]creenshots/
Cave Souls/[Aa]ssets/[Ss]creenshots/

